{
  "id": null,
  "uid": "hwm-industrial-overview",
  "title": "Industrial Hardware Monitoring & Control",
  "tags": [
    "modbus",
    "iot",
    "industrial"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sensor Connectivity",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "hwm_device_online{state=\"\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE / DEGRADED",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Temperature (\u00b0C)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "hwm_sensor_temperature_celsius",
          "legendFormat": "Temp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current Humidity (%)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "hwm_sensor_humidity_percent",
          "legendFormat": "Humidity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Auto Control Loop",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "hwm_control_suspended",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SUSPENDED",
                  "color": "orange"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ambient Temperature & Hysteresis Band (\u00b0C)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "hwm_sensor_temperature_celsius",
          "legendFormat": "Temperature (\u00b0C)"
        },
        {
          "expr": "hwm_control_threshold_celsius{bound=\"on_above\"}",
          "legendFormat": "Fan On Above"
        },
        {
          "expr": "hwm_control_threshold_celsius{bound=\"off_below\"}",
          "legendFormat": "Fan Off Below"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Relative Humidity (%)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "hwm_sensor_humidity_percent",
          "legendFormat": "Humidity (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Relay Channel Read-Back States (0=OFF, 1=ON)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "hwm_relay_channel_state",
          "legendFormat": "CH {{channel}} - {{label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0
        }
      }
    }
  ]
}
